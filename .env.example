# Data source for the dashboard.
# "mock"  — deterministic seeded mock data (default, no network calls).
# "whop"  — live production mode: requires WHOP_API_KEY and WHOP_COMPANY_ID.
DATA_MODE=mock

# --- What the owner must paste here (from the Whop dashboard) ---
# Whop Dashboard → Developer → Apps → Retainly → API keys.
# Never commit a real .env to git.

# Your Whop App ID, e.g. app_xxxxxxxxxxxxxxxx.
# Required for Whop-only auth (verifyUserToken); shown on the app's settings page.
WHOP_APP_ID=

# Production Whop API key (server-side secret, leave empty in mock/demo mode).
# Without it, only /dashboard/demo works.
WHOP_API_KEY=

# Default company id, e.g. biz_xxxxxxxxxxxxxxxx, used for live data fetching.
WHOP_COMPANY_ID=
